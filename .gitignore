# debug thumbnails
_thumb_*.png
# ローカル環境固有の設定ファイルを無視
settings.local.json
supabase/functions/ai-proxy/supabase/

# ── Ops / test tooling (added R133) ──────────────────────────────────────────
# Dev/test dependencies and their build artifacts. The IntMap app itself ships
# NO node_modules — these exist only for CI and local testing.
node_modules/
/test-results/
/playwright-report/
/playwright/.cache/
npm-debug.log*
*.local.env
.env

# ── Supabase local dev + DB backups (added R134) ─────────────────────────────
# CLI local state (link info, downloaded CLI). config.toml/migrations/seed ARE tracked.
supabase/.temp/
supabase/.branches/
supabase/.env
supabase/functions/**/.env
# DB dumps / encrypted backups must NEVER be committed to this public repo.
/backups/
*.dump
*.dump.gpg
*.sql.gpg


# ── Vite build output (added R175) ───────────────────────────────────────────
# `npm run build` emits the deployable tree here; GitHub Pages publishes it from CI.
dist/

# ── (#R209) the frame instrument's tile replay cache ─────────────────────────
# scripts/frame-profile.mjs answers every external request from here so an A/B
# compares identical bytes. Recorded third-party tiles — never committed.
.frame-cache/
